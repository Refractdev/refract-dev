{
  "name": "refract",
  "version": "0.1.0",
  "description": "Transform AI-generated code into maintainable structure",
  "author": "Refract Team",
  "scripts": {
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format --write ./src",
    "check": "biome check ./src",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --port 3000",
    "dev:vercel": "vercel dev --listen 3000",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.0.3",
    "@fontsource/geist-sans": "^5.0.3",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@types/dagre": "^0.7.54",
    "@typescript-eslint/typescript-estree": "^8.59.3",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.35.3",
    "@xyflow/react": "^12.10.2",
    "clsx": "^2.1.0",
    "dagre": "^0.8.5",
    "dotenv": "^17.4.2",
    "groq-sdk": "^0.8.0",
    "isomorphic-git": "^1.25.8",
    "jose": "^6.2.3",
    "lucide-react": "^0.363.0",
    "memfs": "^4.57.2",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.2.2",
    "ws": "^8.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/parser": "^7.18.0",
    "@vercel/node": "^5.1.10",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.3",
    "typescript": "^5.4.2",
    "vercel": "^54.3.0",
    "vite": "^5.1.6"
  }
}
