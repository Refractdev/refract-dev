{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|@vite/|@react-refresh|@fs/|@id/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/ai.ts": {
      "maxDuration": 30
    },
    "api/jobs/process.ts": {
      "maxDuration": 120
    },
    "api/analysis.ts": {
      "maxDuration": 60
    },
    "api/webhooks/github.ts": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/jobs/process",
      "schedule": "0 0 * * *"
    }
  ]
}